{
  "name": "@artemis/domain",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-window-parser": {
      "types": "./dist/event-window-parser.d.ts",
      "default": "./dist/event-window-parser.js"
    },
    "./event-presentation": {
      "types": "./dist/event-presentation.d.ts",
      "default": "./dist/event-presentation.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "chrono-node": "2.10.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
