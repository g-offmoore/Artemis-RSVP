{$APP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# /metrics must never be public (docs/SECURITY.md). This has to be a `handle` block,
	# not a bare `respond` directive: Caddy sorts bare directives by its own default
	# precedence rather than file order, so a bare `respond` sitting next to `handle`
	# blocks is not guaranteed to run before the catch-all `handle {}` below swallows the
	# request into the web proxy. `handle` blocks are evaluated in file order, first
	# match wins, which is what we actually need here.
	handle /metrics {
		respond 404
	}

	handle /healthz {
		reverse_proxy api:3000
	}

	handle /readyz {
		reverse_proxy api:3000
	}

	handle /api/v1/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
